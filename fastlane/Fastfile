require "google/apis/androidpublisher_v3"
require "googleauth"

default_platform(:android)

# Moves the draft release of the given versionCode to completed on the production track.
def promote_to_production(version_code)
  project_root = File.expand_path("..", Dir.pwd)
  key_path = ENV["PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH"] ||
             File.join(project_root, "fastlane/play-store-service-account.json")
  UI.user_error!("Play service account key not found at #{key_path}") unless File.exist?(key_path)

  package_name = ENV["PASSHASH_PACKAGE_NAME"] || "ru.co_dev.passhash"
  service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
  service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: File.open(key_path),
    scope: Google::Apis::AndroidpublisherV3::AUTH_ANDROIDPUBLISHER
  )

  edit = service.insert_edit(package_name)
  begin
    track = service.get_edit_track(package_name, edit.id, "production")
    release = (track.releases || []).find { |r| (r.version_codes || []).include?(version_code) }
    UI.user_error!("versionCode #{version_code} is not on the production track") unless release

    if release.status == "completed"
      UI.important("versionCode #{version_code} is already published — nothing to do")
    else
      unless release.status == "draft"
        UI.user_error!("versionCode #{version_code} has status '#{release.status}', expected 'draft'")
      end
      release.status = "completed"
      release.user_fraction = nil
      service.update_edit_track(package_name, edit.id, "production", track)
      service.commit_edit(package_name, edit.id)
      UI.success("Published versionCode #{version_code} to the production track")
    end
  rescue StandardError
    begin
      service.delete_edit(package_name, edit.id)
    rescue StandardError
      nil
    end
    raise
  end
end

platform :android do
  desc "Upload a signed AAB to Google Play and publish it on the production track"
  lane :release do |options|
    version_code = options[:version_code].to_i
    UI.user_error!("Pass version_code: (from the release tag commit)") if version_code.zero?

    # Lanes run with the working directory set to the fastlane folder, so every
    # path has to be resolved against the project root explicitly.
    project_root = File.expand_path("..", Dir.pwd)
    default_aab = File.join(project_root, "android/app/build/outputs/bundle/release/*.aab")
    aab = options[:aab] ? File.expand_path(options[:aab], project_root) : Dir[default_aab].first

    existing = %w[production beta alpha internal].flat_map do |track|
      begin
        google_play_track_version_codes(track: track)
      rescue StandardError
        []
      end
    end

    if existing.include?(version_code)
      # A previous run already uploaded this build as a draft; publishing is enough,
      # because Play rejects a second upload of an existing versionCode.
      UI.important("versionCode #{version_code} is already uploaded — publishing it instead of uploading again")
      promote_to_production(version_code)
      next
    end

    if existing.any? && version_code < existing.max
      UI.user_error!("versionCode #{version_code} must be greater than the highest uploaded one (#{existing.max})")
    end

    UI.user_error!("AAB not found (looked in #{default_aab})") unless aab && File.exist?(aab)

    # R8 minification is enabled for release builds, so crashes arrive obfuscated
    # unless the mapping file is uploaded together with the bundle.
    mapping = File.join(project_root, "android/app/build/outputs/mapping/release/mapping.txt")
    UI.user_error!("R8 mapping not found at #{mapping}") unless File.exist?(mapping)

    upload_to_play_store(
      track: "production",
      release_status: "completed",
      aab: aab,
      mapping: mapping,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Publish an already uploaded draft release of the given versionCode"
  lane :publish do |options|
    version_code = options[:version_code].to_i
    UI.user_error!("Pass version_code: (the draft to publish)") if version_code.zero?

    promote_to_production(version_code)
  end
end
